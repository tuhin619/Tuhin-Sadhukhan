# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (or Vercel deployment URL).
APP_URL="https://my-ebook-store.vercel.app"

# -------------------------------------------------------------
# SUPABASE CONFIGURATION (For PostgreSQL, Auth & File Storage)
# -------------------------------------------------------------
# Find these in your Supabase project dashboard under Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# -------------------------------------------------------------
# STORE & UPI PAYMENT CONFIGURATION
# -------------------------------------------------------------
# Configurable UPI ID for receiving customer payments (e.g., sadhukhantuhin12@okaxis)
NEXT_PUBLIC_STORE_UPI_ID="sadhukhantuhin12@okaxis"
NEXT_PUBLIC_OWNER_NAME="Tuhin Sadhukhan"
NEXT_PUBLIC_STORE_NAME="Tuhin's Digital Book Vault"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# -------------------------------------------------------------
# ADMIN DASHBOARD SECURITY
# -------------------------------------------------------------
# Master secret passkey for server-side admin verification and first-time setup
ADMIN_SECRET_KEY="change_this_to_a_secure_admin_passkey_2026"
